# AutoSE Platform Environment Variables
# Copy this file to .env and update the values

# Application settings
DEBUG=True
HOST=0.0.0.0
PORT=8000

# CORS settings (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Chutes LLM API settings (OpenAI-compatible) - Recommended
CHUTES_API_KEY=cpk_242077861b674c02864c0148fc9a0d72.603fe92b85175927880e86c817a4d5d3.WNg1D5dcF83NCPhoDdwNy4b8uOWTaFZq
CHUTES_API_URL=https://llm.chutes.ai/v1
CHUTES_MODEL=deepseek-ai/DeepSeek-V3-0324

# Legacy DeepSeek LLM API settings (for backward compatibility)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODEL=deepseek-chat

# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=3600  # 1 hour in seconds

# Cache settings
CACHE_TTL=300  # 5 minutes in seconds

# Validation settings
POWER_THRESHOLD_W=5000
